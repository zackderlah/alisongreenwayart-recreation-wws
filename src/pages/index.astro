---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/templates/HomePage.astro";
import { pages } from "../lib/cms";
import { createWWS } from "../wws-cms/sdk";
import { createHomeFallback, validateHomeContent } from "../wws-cms/home";

const page = pages["/"];
if (!page) throw new Error("Home page data missing");

const fallbackContent = createHomeFallback(page);
let content = fallbackContent;

try {
  const published = await createWWS({
    cmsUrl: "http://localhost:3000",
    site: "alisongreenwayart-recreation-wws"
  }).getWWSContent("home");
  content = validateHomeContent(published) ?? fallbackContent;
} catch {
  content = fallbackContent;
}
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <HomePage content={content} />
</BaseLayout>
