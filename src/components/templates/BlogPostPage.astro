---
import ArticleBlocks from "../ArticleBlocks.astro";

const { page } = Astro.props;
---

<section class="px-4 py-8">
  <article>
  <div class="mx-auto max-w-3xl">
    <h1 class="mb-6 text-center text-2xl font-semibold text-text md:text-3xl">{page.heading}</h1>

    {page.image && (
      <img
        src={page.image}
        alt={page.imageAlt || page.heading}
        class="mx-auto mb-8 w-full max-w-4xl"
      />
    )}

    {page.lead && (
      <p class="mb-6 text-lg font-semibold leading-relaxed text-text md:text-xl">{page.lead}</p>
    )}

    <ArticleBlocks blocks={page.blocks} />
  </div>
  </article>
</section>
