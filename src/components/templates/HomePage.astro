---
import Button from "../Button.astro";
import { site } from "../../lib/cms";
import { wwsSectionField } from "../../wws-cms/sdk";
import type {
  CategoriesSection,
  GiftSection,
  HeroSection,
  HomeSection,
  IntroSection,
  SpecialSection,
  WWSHomeContent
} from "../../wws-cms/home";

interface Props {
  content: WWSHomeContent;
}

const { content } = Astro.props;
const sectionClass = (section: HomeSection, extra = "") =>
  `wws-section wws-spacing-${section.spacing} wws-visibility-${section.visibility} wws-columns-${section.columns} ${extra}`;
---

<div id="wws-home-sections">
  {content._structure.sections.map((section) => {
    if (section.type === "hero") {
      const item = section as HeroSection;
      return (
        <section
          class={sectionClass(item, "px-4 py-16 text-center")}
          data-wws-field={wwsSectionField(item.id)}
        >
          <div class="mx-auto max-w-4xl">
            <h1 class="font-display text-4xl font-semibold text-text md:text-5xl">{item.content.line1}</h1>
            <p class="mt-2 text-3xl font-bold text-accent md:text-4xl">{item.content.line2}</p>
            <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-text">{item.content.line3}</p>
            <div class="mt-8">
              <Button href={item.content.ctaUrl} variant="secondary">{item.content.ctaLabel}</Button>
            </div>
          </div>
        </section>
      );
    }

    if (section.type === "intro") {
      const item = section as IntroSection;
      return (
        <section
          class={sectionClass(item, "bg-[#f5f5f5] px-4 py-16")}
          data-wws-field={wwsSectionField(item.id)}
        >
          <div class="wws-grid mx-auto grid max-w-6xl gap-10 md:grid-cols-2 md:items-center">
            <div>
              <h2 class="mb-6 text-2xl font-bold text-text">{item.content.heading}</h2>
              {item.content.paragraphs.map((paragraph) => (
                <p class="mb-4 leading-relaxed text-text">{paragraph.text}</p>
              ))}
              <div class="mt-8 flex flex-wrap gap-4">
                <Button href={`tel:${site.phone}`} variant="primary">{site.phone}</Button>
                <Button href={item.content.contactUrl} variant="outline">{item.content.contactLabel}</Button>
              </div>
            </div>
            {item.content.image && (
              <div class="text-center">
                <img
                  src={item.content.image}
                  alt={item.content.imageAlt}
                  class="mx-auto border border-gray-300 shadow-sm"
                />
                <p class="mt-4 text-sm font-medium text-text">{item.content.caption}</p>
              </div>
            )}
          </div>
        </section>
      );
    }

    if (section.type === "special") {
      const item = section as SpecialSection;
      return (
        <section
          class={sectionClass(item, "px-4 py-16 text-center")}
          data-wws-field={wwsSectionField(item.id)}
        >
          <h2 class="text-2xl font-bold text-accent md:text-3xl">{item.content.heading}</h2>
          <p class="mt-2 font-semibold text-text">{item.content.subheading}</p>
          <div class="wws-grid mx-auto mt-10 grid max-w-5xl gap-8 text-left md:grid-cols-2">
            {item.content.paragraphs.map((paragraph) => (
              <p class="leading-relaxed text-text">{paragraph.text}</p>
            ))}
          </div>
        </section>
      );
    }

    if (section.type === "categories") {
      const item = section as CategoriesSection;
      return (
        <section
          class={sectionClass(item, "px-4 py-16 text-center")}
          data-wws-field={wwsSectionField(item.id)}
        >
          <h2 class="text-2xl font-bold text-text">{item.content.heading}</h2>
          <p class="mt-2 text-gray-600">{item.content.subheading}</p>
          <div class="wws-grid mx-auto mt-10 grid max-w-5xl gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {item.content.items.map((category) => (
              <a href={category.url} class="group">
                {category.image && (
                  <img
                    src={category.image}
                    alt={category.imageAlt}
                    class="mx-auto mb-4 border border-gray-300 transition group-hover:opacity-90"
                  />
                )}
                <span class="inline-block w-full bg-brand px-4 py-3 text-sm font-semibold text-white group-hover:bg-brand-dark">
                  {category.label}
                </span>
              </a>
            ))}
          </div>
        </section>
      );
    }

    if (section.type === "gift") {
      const item = section as GiftSection;
      return (
        <section
          class={sectionClass(item, "bg-[#f5f5f5] px-4 py-16")}
          data-wws-field={wwsSectionField(item.id)}
        >
          <div class="wws-grid mx-auto grid max-w-6xl gap-10 md:grid-cols-2 md:items-center">
            {item.content.image && (
              <img src={item.content.image} alt={item.content.imageAlt} class="w-full" />
            )}
            <div>
              <h2 class="mb-6 text-2xl font-bold text-text">{item.content.heading}</h2>
              {item.content.paragraphs.map((paragraph) => (
                <p class="mb-4 leading-relaxed text-text">{paragraph.text}</p>
              ))}
            </div>
          </div>
        </section>
      );
    }

    return null;
  })}
</div>

<script>
  import { connectWWSPreview } from "../../wws-cms/sdk";
  import { validateHomeContent } from "../../wws-cms/home";
  import { renderHomeContent } from "../../wws-cms/home-dom";

  const cmsOrigin = "http://localhost:3000";
  const container = document.getElementById("wws-home-sections");
  const disconnect = connectWWSPreview({
    cmsOrigin,
    onContent(content) {
      const validated = validateHomeContent(content);
      if (validated && container) renderHomeContent(container, validated);
    }
  });

  const cleanup = () => disconnect();
  window.addEventListener("pagehide", cleanup, { once: true });
  document.addEventListener("astro:before-swap", cleanup, { once: true });
</script>
