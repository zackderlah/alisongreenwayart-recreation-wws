---
import { site } from "../../lib/cms";

const { page } = Astro.props;
---

<section class="px-4 py-16 text-center">
  <div class="mx-auto max-w-4xl">
    <h1 class="font-display text-4xl font-semibold text-text md:text-5xl">{page.hero.line1}</h1>
    <p class="mt-2 text-3xl font-bold text-accent md:text-4xl">{page.hero.line2}</p>
    <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-text">{page.hero.line3}</p>
    <div class="mt-8">
      <a href={page.hero.cta.href} class="inline-flex items-center justify-center bg-accent px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-hover">{page.hero.cta.label}</a>
    </div>
    <img src={page.hero.image.src} alt={page.hero.image.alt} class="mx-auto mt-8 max-h-80 w-auto object-contain" />
  </div>
</section>

<section class="bg-[#f5f5f5] px-4 py-16">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 md:flex-row md:items-center">
    <div class="md:flex-1">
      <h2 class="mb-6 text-2xl font-bold text-text">{page.introHeading}</h2>
      {page.introParagraphs.map((p: string) => (
        <p class="mb-4 leading-relaxed text-text">{p}</p>
      ))}
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={site.phoneHref} class="inline-flex items-center justify-center bg-brand px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark">{site.phone}</a>
        <a href={page.contactCta.href} class="inline-flex items-center justify-center border border-gray-400 bg-white px-6 py-3 text-sm font-semibold text-text transition-colors hover:bg-gray-50">{page.contactCta.label}</a>
      </div>
    </div>
    <div class="text-center md:flex-1">
      <img src={page.introImage.src} alt={page.introImage.alt} class="mx-auto border border-gray-300 shadow-sm" />
      <p class="mt-4 text-sm font-medium text-text">{page.artworkNote}</p>
    </div>
  </div>
</section>

<section class="px-4 py-16 text-center">
  <h2 class="text-2xl font-bold text-accent md:text-3xl">{page.specialHeading}</h2>
  <p class="mt-2 font-semibold text-text">{page.specialSubheading}</p>
  <div class="mx-auto mt-10 flex max-w-5xl flex-wrap justify-between gap-y-8 text-left">
    {page.specialParagraphs.map((p: string) => (
      <p class="w-full leading-relaxed text-text md:w-[48%]">{p}</p>
    ))}
  </div>
</section>

<section class="px-4 py-16 text-center">
  <h2 class="text-2xl font-bold text-text">{page.categoryHeading}</h2>
  <p class="mt-2 text-gray-600">{page.categorySubheading}</p>
  <div class="mx-auto mt-10 flex max-w-5xl flex-wrap justify-between gap-y-8">
    {page.categories.map((cat: { href: string; label: string; image: { src: string; alt: string } }) => (
      <a href={cat.href} class="group w-full sm:w-[48%] lg:w-[23%]">
        <img src={cat.image.src} alt={cat.image.alt || cat.label} class="mx-auto mb-4 border border-gray-300 transition group-hover:opacity-90" />
        <span class="inline-block w-full bg-brand px-4 py-3 text-sm font-semibold text-white group-hover:bg-brand-dark">
          {cat.label}
        </span>
      </a>
    ))}
  </div>
</section>

<section class="bg-[#f5f5f5] px-4 py-16">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 md:flex-row md:items-center">
    <img src={page.giftImage.src} alt={page.giftImage.alt} class="w-full md:w-[48%]" />
    <div class="md:flex-1">
      <h2 class="mb-6 text-2xl font-bold text-text">{page.giftHeading}</h2>
      {page.giftParagraphs.map((p: string) => (
        <p class="mb-4 leading-relaxed text-text">{p}</p>
      ))}
    </div>
  </div>
</section>
