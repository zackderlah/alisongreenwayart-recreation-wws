---
const { page } = Astro.props;
const groups = page.groups || [];
---

<section class="bg-gradient-to-b from-[#f0eeec] to-white px-4 py-12 text-center">
  <div class="mx-auto max-w-4xl">
    <h1 class="text-2xl font-semibold text-text md:text-3xl">{page.heading}</h1>
    <p class="mt-2 text-gray-600">Fine Art Giclee Prints</p>
    <p class="mt-1 text-sm text-gray-500">Quality Reproductions on 240 gsm Premium Textured Cotton Rag Paper</p>
    {(page.intro || []).map((p: string) => (
      <p class="mt-4 leading-relaxed text-text">{p}</p>
    ))}
  </div>
</section>

{groups.map((group: { name: string; items: Array<{ title: string; href: string }> }) => (
  <section class="px-4 py-8">
    <div class="mx-auto max-w-6xl">
      {group.name !== "Collection" && (
        <div class="mb-6 bg-brand py-3 text-center text-white font-semibold">{group.name}</div>
      )}
      <div class={`grid gap-8 sm:grid-cols-2 ${group.items.length > 9 ? "lg:grid-cols-4" : "lg:grid-cols-3"}`}>
        {group.items.map((item: { title: string; href: string; image?: string }) => (
          <a href={item.href} class="group text-center">
            {item.image ? (
              <img src={item.image} alt={item.title} class="mx-auto border border-gray-300 transition group-hover:border-brand" />
            ) : (
              <div class="aspect-[4/3] border border-gray-300 bg-gray-50 transition group-hover:border-brand" />
            )}
            <p class="mt-3 text-sm font-medium text-text group-hover:text-brand">{item.title}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
))}
