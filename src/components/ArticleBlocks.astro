---
import InlineSegments from "./InlineSegments.astro";

const { blocks = [], class: className = "" } = Astro.props;
---

<div class={className}>
  {blocks.map((block: any) => (
    <>
      {block.type === "heading" && <h2 class="mb-4 mt-10 text-xl font-bold text-text">{block.text}</h2>}
      {block.type === "paragraph" && (
        <p class="mb-4 leading-relaxed text-text">
          {block.segments ? <InlineSegments segments={block.segments} /> : block.text}
        </p>
      )}
      {block.type === "list" && (
        <ul class="mb-6 list-disc space-y-2 pl-6 text-text">
          {block.items.map((item: string) => <li class="leading-relaxed">{item}</li>)}
        </ul>
      )}
      {block.type === "image" && (
        <img src={block.src} alt={block.alt || ""} class="mx-auto my-8 w-[90%] border-[20px] border-[#faf9f2]" />
      )}
    </>
  ))}
</div>
